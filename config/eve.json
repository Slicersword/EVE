{
  "robot": {"name": "EVE", "language": "en",
            "wake_words": ["eve", "eva", "evea", "evie", "ईव्हा", "ईवा", "इवा", "इव्हा"]},
  "hardware": {"ina219_enabled": false},
  "serial": {"port": "/dev/ttyUSB0", "baud": 115200, "settle_s": 2.0, "ack_timeout_s": 0.25},
  "power": {"topology": "two_independent_usb_5v_power_banks", "session_max_minutes": 30,
            "note": "Bank A = Pi (+display/fan if verified). Bank B = motors, head, audio. 5 V only. No battery readings exist."},
  "firmware": {"drive_enabled": false, "head_enabled": false, "watchdog_enabled": true},
  "drive": {"max_pwm": 150, "test_pwm": 80, "test_seconds": 1.0, "move_max_seconds": 2.0,
            "ramp_per_second": 300, "reverse_deadtime_ms": 150,
            "obstacle_stop_mm": 150, "obstacle_warn_mm": 300, "command_lease_ms": 250,
            "reverse_allowed": false, "pivot_allowed": false},
  "head": {"pan_min_steps": -650, "pan_max_steps": 650, "tilt_min_steps": -260, "tilt_max_steps": 260,
           "soft_limits_verified": false, "jog_max_steps": 8},
  "safety": {"sensor_timeout_ms": 500, "heartbeat_ms": 100, "mega_watchdog_ms": 350, "max_tilt_deg": 28.0},
  "sensors": {"tof_xshut": [5, 6, 13], "tof_addresses": [48, 49, 50], "imu_address": 104, "imu_inverted": false,
              "tof_range_mm": [30, 1000],
              "cliff_calibration": {"calibrated": false, "edge_level": [0, 0, 0]}},
  "touch": {"enabled": true, "head_gpio": 27, "back_gpio": 22, "hold_stop_s": 1.0},
  "camera": {"enabled": false, "led_gpio": 25, "width": 640, "height": 360, "process_fps": 5,
             "allow_tracking": false, "tracking_deadband": 0.12, "tracking_step": 8,
             "tracking_pan_sign": 1, "tracking_tilt_sign": 1,
             "cascade_path": "/usr/share/opencv4/haarcascades/haarcascade_frontalface_default.xml"},
  "memory": {"enabled": true, "db": "data/eve.db", "max_notes": 500},
  "ai": {"offline_dialogue_enabled": true,
         "local_llm": {"enabled": false, "endpoint": "http://127.0.0.1:8081/v1/chat/completions",
                       "max_tokens": 96, "timeout_s": 20, "max_input_chars": 400},
         "cloud": {"enabled": false, "privacy_consent": false, "send_private_data": false,
                   "endpoint": "", "model": "", "key_file": "data/cloud.key",
                   "max_requests_per_day": 50, "timeout_s": 30, "max_tokens": 200}},
  "voice": {"languages": ["en", "hi", "mr"], "tts_enabled": true, "tts_command": "espeak-ng",
            "tts_speed": 150, "capture_enabled": false, "capture_device": "default", "echo_cancel_enabled": false,
            "sample_rate": 16000, "vad_rms": 500, "max_utterance_s": 8, "require_wake_word": true,
            "stt_command": "third_party/whisper.cpp/build/bin/whisper-cli",
            "stt_model": "models/ggml-tiny.bin", "stt_language": "auto", "stt_timeout_s": 30,
            "silence_s": 0.7, "follow_up_s": 20},
  "behavior": {"enabled": true, "greet_cooldown_s": 600, "night_start_hour": 22, "night_end_hour": 7,
               "utc_offset_minutes": 0},
  "sleep": {"idle_minutes": 15},
  "integrations": {"web_tools_enabled": false},
  "network": {"host": "127.0.0.1", "port": 8765},
  "storage": {"data_dir": "data"},
  "commissioning": {"power_a_verified": false, "power_b_verified": false, "motor_current_verified": false,
                    "contained_ground_area": false, "drive_verified": false, "head_verified": false},
  "pins": {"mega": {"left": [8, 22, 23, 2, 24, 25, 3], "right": [9, 26, 27, 4, 28, 29, 5],
                    "pan": [30, 31, 32, 33], "tilt": [34, 35, 36, 37], "pir": 38, "cliff": [39, 40, 41]}}
}
